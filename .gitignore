# ============================================================
# Large data files and indexes (regenerate from scripts)
# ============================================================
# The ColBERT index is 64 GB — keep the eval pipeline, not the index
data/colbert_index/
data/colbert_index/**
# The dense index is 3.2 GB
data/dense_index/
data/dense_index/**
# The corpus itself (3.3 GB) is regenerated by the ingest pipeline
data/all_documents/
data/all_documents/**
# A separate finance-and-legal corpus sample — keep out of the public repo
finance-and-legal/

# Large per-question result files
data/rrf_full_ranking_N2000_k060.jsonl
data/jina_v3_topk_docids.jsonl
data/bm25_topk_docids.jsonl

