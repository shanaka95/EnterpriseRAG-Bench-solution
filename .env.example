# MiniMax (Anthropic-compatible) endpoint for the reactive RAG agent.
# Copy this file to .env and fill in your real API key. The .env file is
# sourced automatically by scripts/run_ui.sh.

MINIMAX_API_KEY=sk-cp-...
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# Langfuse tracing (https://cloud.langfuse.com or self-hosted). Leave any
# blank to disable tracing. The agent auto-detects these on every run
# and attaches a callback handler to every LLM/tool call when set.
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
